{
 "title": "TracePilot AI",
 "uid": "tracepilot",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Investigations / min by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(tracepilot_investigations_total[5m])) * 60",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Investigation duration p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(tracepilot_investigation_seconds_bucket[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Tool calls by tool/status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tool, status) (rate(tracepilot_tool_calls_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "LLM tokens / min",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (rate(tracepilot_llm_tokens_total[5m])) * 60",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "LLM cost (USD, cumulative)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "tracepilot_llm_cost_usd_total",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Rate-limited requests",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(tracepilot_rate_limited_total[5m])",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  }
 ]
}